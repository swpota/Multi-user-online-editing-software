/* Landing Page - Windsurf风格 */

.landing-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 50%, #0F172A 100%);
  color: #F8FAFC;
}

/* ==================== 导航栏 ==================== */
.landing-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.8);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(148, 163, 184, 0.1);
}

.landing-header-content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.landing-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1.25rem;
  font-weight: 700;
  color: #F8FAFC;
}

.landing-logo img {
  width: 32px;
  height: 32px;
  padding: 6px;
  background: rgba(248, 250, 252, 0.95);
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.landing-nav {
  display: flex;
  gap: 2rem;
}

.landing-nav a {
  color: #CBD5E1;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s;
}

.landing-nav a:hover {
  color: #F8FAFC;
}

.landing-auth-buttons {
  display: flex;
  gap: 1rem;
}

/* ==================== 按钮样式 ==================== */
.landing-btn {
  padding: 0.625rem 1.5rem;
  border-radius: 8px;
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
  border: none;
}

.landing-btn-ghost {
  background: transparent;
  color: #F8FAFC;
  border: 1px solid rgba(148, 163, 184, 0.3);
}

.landing-btn-ghost:hover {
  background: rgba(148, 163, 184, 0.1);
  border-color: rgba(148, 163, 184, 0.5);
}

.landing-btn-primary {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  color: #FFFFFF;
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
}

.landing-btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4);
}

.landing-btn-secondary {
  background: rgba(148, 163, 184, 0.1);
  color: #F8FAFC;
  border: 1px solid rgba(148, 163, 184, 0.3);
}

.landing-btn-secondary:hover {
  background: rgba(148, 163, 184, 0.2);
}

.landing-btn-large {
  padding: 0.875rem 2rem;
  font-size: 1rem;
}

/* ==================== 英雄区域 ==================== */
.landing-hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 6rem 2rem 4rem;
}

.landing-hero-background {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.landing-gradient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.4;
  animation: float 20s ease-in-out infinite;
}

.orb-1 {
  width: 500px;
  height: 500px;
  background: linear-gradient(135deg, #3B82F6, #8B5CF6);
  top: -200px;
  left: -200px;
  animation-delay: 0s;
}

.orb-2 {
  width: 400px;
  height: 400px;
  background: linear-gradient(135deg, #06B6D4, #3B82F6);
  bottom: -150px;
  right: -150px;
  animation-delay: 5s;
}

.orb-3 {
  width: 300px;
  height: 300px;
  background: linear-gradient(135deg, #8B5CF6, #EC4899);
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  animation-delay: 10s;
}

@keyframes float {
  0%, 100% {
    transform: translate(0, 0);
  }
  25% {
    transform: translate(30px, -30px);
  }
  50% {
    transform: translate(-20px, 20px);
  }
  75% {
    transform: translate(20px, -20px);
  }
}

.landing-hero-content {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  text-align: center;
}

.landing-hero-title {
  font-size: 4rem;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 1.5rem;
  color: #F8FAFC;
}

.landing-hero-highlight {
  background: linear-gradient(135deg, #3B82F6 0%, #8B5CF6 50%, #EC4899 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.landing-hero-subtitle {
  font-size: 1.25rem;
  color: #CBD5E1;
  margin-bottom: 2.5rem;
  font-weight: 400;
}

.landing-hero-cta {
  display: flex;
  gap: 1rem;
  justify-content: center;
  margin-bottom: 4rem;
}

/* ==================== 产品截图模拟 ==================== */
.landing-hero-image {
  max-width: 900px;
  margin: 0 auto;
}

.landing-mockup {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(10px);
}

.mockup-header {
  background: rgba(30, 41, 59, 0.8);
  padding: 1rem 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  border-bottom: 1px solid rgba(148, 163, 184, 0.1);
}

.mockup-dots {
  display: flex;
  gap: 0.5rem;
}

.mockup-dots span {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: rgba(148, 163, 184, 0.3);
}

.mockup-dots span:nth-child(1) {
  background: #EF4444;
}

.mockup-dots span:nth-child(2) {
  background: #F59E0B;
}

.mockup-dots span:nth-child(3) {
  background: #10B981;
}

.mockup-title {
  color: #CBD5E1;
  font-size: 0.875rem;
}

.mockup-content {
  padding: 2rem;
  min-height: 400px;
}

.mockup-line {
  height: 12px;
  background: rgba(148, 163, 184, 0.2);
  border-radius: 6px;
  margin-bottom: 1rem;
  animation: shimmer 2s ease-in-out infinite;
}

.mockup-line.short {
  width: 60%;
}

.mockup-line.medium {
  width: 80%;
}

@keyframes shimmer {
  0%, 100% {
    opacity: 0.4;
  }
  50% {
    opacity: 0.7;
  }
}

/* ==================== 特性区域 ==================== */
.landing-features {
  padding: 6rem 2rem;
  background: rgba(15, 23, 42, 0.5);
}

.landing-features-content {
  max-width: 1200px;
  margin: 0 auto;
}

.landing-section-title {
  text-align: center;
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: #F8FAFC;
}

.landing-section-subtitle {
  text-align: center;
  font-size: 1.125rem;
  color: #CBD5E1;
  margin-bottom: 4rem;
}

.landing-features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}

.landing-feature-card {
  background: rgba(30, 41, 59, 0.5);
  border: 1px solid rgba(148, 163, 184, 0.1);
  border-radius: 16px;
  padding: 2rem;
  transition: all 0.3s;
  backdrop-filter: blur(10px);
}

.landing-feature-card:hover {
  transform: translateY(-4px);
  border-color: rgba(59, 130, 246, 0.3);
  box-shadow: 0 12px 24px rgba(59, 130, 246, 0.15);
}

.feature-icon {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.feature-title {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: #F8FAFC;
}

.feature-description {
  color: #94A3B8;
  line-height: 1.6;
}

/* ==================== CTA区域 ==================== */
.landing-cta {
  padding: 6rem 2rem;
  background: rgba(59, 130, 246, 0.05);
}

.landing-cta-content {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
}

.landing-cta-title {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 1rem;
  color: #F8FAFC;
}

.landing-cta-subtitle {
  font-size: 1.125rem;
  color: #CBD5E1;
  margin-bottom: 2rem;
}

/* ==================== 页脚 ==================== */
.landing-footer {
  padding: 3rem 2rem;
  background: rgba(15, 23, 42, 0.8);
  border-top: 1px solid rgba(148, 163, 184, 0.1);
}

.landing-footer-content {
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

.landing-footer-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  font-size: 1.25rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  color: #F8FAFC;
}

.landing-footer-logo img {
  width: 32px;
  height: 32px;
  padding: 6px;
  background: rgba(248, 250, 252, 0.95);
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
}

.landing-footer-links {
  display: flex;
  gap: 2rem;
  justify-content: center;
  margin-bottom: 1.5rem;
}

.landing-footer-links a {
  color: #94A3B8;
  text-decoration: none;
  transition: color 0.2s;
}

.landing-footer-links a:hover {
  color: #F8FAFC;
}

.landing-footer-copyright {
  color: #64748B;
  font-size: 0.875rem;
}

/* ==================== 响应式 ==================== */
@media (max-width: 768px) {
  .landing-nav {
    display: none;
  }

  .landing-hero-title {
    font-size: 2.5rem;
  }

  .landing-hero-subtitle {
    font-size: 1rem;
  }

  .landing-hero-cta {
    flex-direction: column;
    align-items: center;
  }

  .landing-features-grid {
    grid-template-columns: 1fr;
  }

  .landing-section-title {
    font-size: 2rem;
  }

  .landing-footer-links {
    flex-wrap: wrap;
  }
}
